package merlin:plugin@0.5.0;

interface types {
  /// What a run of text is, for its colour.
  enum token-kind {
    plain,
    keyword,
    %string,
    comment,
    function,
    %type,
    constant,
    attribute,
    property,
    operator,
    punctuation,
    escape,
    variable,
    macro,
  }

  /// Which colours a plugin sends: `base` replaces the editor's own grammar
  /// for the file, as a VS Code grammar does; `semantic` goes over it, as
  /// semantic tokens do.
  enum token-layer {
    base,
    semantic,
  }

  /// A coloured run of text, within one line or across several.
  record token {
    start: position,
    end: position,
    kind: token-kind,
  }

  /// A symbol in a file, for the Outline, breadcrumbs and Go to Symbol.
  record doc-symbol {
    name: string,
    /// Such as `function`, `class`, `method`, `namespace`, `field`.
    kind: string,
    /// Shown after the name, such as a signature.
    detail: string,
    start: position,
    end: position,
    /// How many symbols it's inside.
    depth: u32,
  }

  /// A symbol anywhere in the project, for the palette's search.
  record project-symbol {
    name: string,
    /// Such as `function`, `struct`, `method`.
    kind: string,
    /// What it's in, such as `impl Editor`; empty for nothing.
    container: string,
    /// Relative to the workspace root, or absolute.
    path: string,
    start: position,
  }

  /// Lines `start` up to `end`, not including it.
  record line-range {
    start: u32,
    end: u32,
  }

  /// A block that folds: its first and last lines.
  record fold-range {
    first: u32,
    last: u32,
  }

  /// A setting's value. Lists and tables come as their TOML text.
  variant setting {
    text(string),
    flag(bool),
    integer(s64),
    float(f64),
    other(string),
  }

  record command {
    /// Local to the plugin. The editor runs it as `<plugin>.<id>`.
    id: string,
    title: string,
    /// A key that runs it, such as `ctrl+alt+w`. It needs Ctrl or Alt, and
    /// is ignored with a warning if the editor already uses it.
    key: option<string>,
  }

  record button {
    id: string,
    label: string,
  }

  enum tone {
    normal,
    muted,
    strong,
    warning,
    error,
  }

  record styled {
    text: string,
    tone: tone,
  }

  /// A text field. The editor keeps what's typed in it across re-renders,
  /// and sends it to `on-submit` on Enter.
  record input {
    id: string,
    placeholder: string,
    /// Shows dots instead of the text, for passwords and API keys.
    secret: bool,
  }

  /// A row that can be focused and clicked like a button, drawn as text:
  /// a file in a list, a problem in a file.
  record item {
    id: string,
    label: string,
    tone: tone,
  }

  /// Panels are data. The editor lays them out and owns focus, scrolling,
  /// selection and input text, so re-rendering never resets them.
  variant node {
    heading(string),
    /// Wrapped to the panel width; newlines are kept.
    text(string),
    styled(styled),
    button(button),
    /// Buttons side by side.
    buttons(list<button>),
    /// Clicks arrive at `on-click` with its id.
    item(item),
    /// Markdown: headings, lists, quotes, bold, italics,
    /// inline code, links, and fenced code blocks with syntax colours.
    markdown(string),
    input(input),
    divider,
    /// Nodes after this stay at the bottom of the panel. The nodes before it
    /// scroll, and keep the newest content in view.
    footer,
  }

  record panel {
    title: string,
    nodes: list<node>,
  }

  record pick-item {
    id: string,
    label: string,
  }

  /// How messages on a process's stdout and stdin are delimited.
  enum framing {
    /// One message per line (JSON-RPC over stdio, ACP).
    lines,
    /// `Content-Length` headers (LSP).
    content-length,
  }

  variant process-event {
    message(string),
    stderr(string),
    /// The exit code, or none if a signal ended the process.
    exit(option<s32>),
  }

  /// A place in a file: a line, and a column counted in UTF-16 code units,
  /// as LSP counts them. Both start at 0.
  record position {
    line: u32,
    column: u32,
  }

  enum severity {
    error,
    warning,
    info,
    hint,
  }

  /// A change to a buffer: the range it replaced, in the text as it was
  /// just before, and what replaced it. As LSP's incremental sync has it.
  record text-change {
    start: position,
    end: position,
    text: string,
  }

  /// What a code action does, for the group it's listed in.
  enum action-kind {
    quick-fix,
    refactor,
    source,
    other,
  }

  /// Something the user can do to the code at the cursor, such as fixing a
  /// problem. Choosing it calls `on-pick` with picker `code-actions` and
  /// its id. The preferred one is the likeliest fix.
  record code-action {
    id: string,
    title: string,
    kind: action-kind,
    preferred: bool,
  }

  /// Changes to one file, each in the text as it is before any of them,
  /// as an LSP workspace edit has them. The path is relative to the
  /// workspace root, or absolute.
  record file-edit {
    path: string,
    edits: list<text-change>,
  }

  /// What renaming the name at the cursor would change: the name's own
  /// place in the active file, and how many places and files use it.
  record rename-info {
    start: position,
    end: position,
    places: u32,
    files: u32,
  }

  /// A place in a file, as a reference to a name. The path is relative to
  /// the workspace root, or absolute.
  record location {
    path: string,
    start: position,
    end: position,
  }

  /// Selected text and where it is.
  record selection {
    start: position,
    end: position,
    text: string,
  }

  record diagnostic {
    start: position,
    end: position,
    severity: severity,
    message: string,
  }

  /// A diagnostic with what reported it, such as `rustc` or `clippy`, its
  /// code, such as `E0308`, and a web page that explains the code. Any may
  /// be empty.
  record detailed-diagnostic {
    diagnostic: diagnostic,
    source: string,
    code: string,
    link: string,
  }

  record completion {
    label: string,
    /// Shown dimmed after the label, such as a type.
    detail: string,
    /// What replaces the word at the cursor when it's chosen.
    insert: string,
  }

  /// The signature of the call being typed. `active` is the parameter the
  /// cursor is in, as a range of the label's characters.
  record signature {
    label: string,
    active: option<tuple<u32, u32>>,
    /// A line or two of its documentation, as plain text.
    doc: string,
    /// Which overload this is, from 0, and how many there are.
    index: u32,
    count: u32,
  }

  /// What an inlay hint names.
  enum inlay-kind {
    %type,
    parameter,
    other,
  }

  /// A hint written between the characters, before the one at `at`: a
  /// variable's type, or a parameter's name.
  record inlay-hint {
    at: position,
    label: string,
    kind: inlay-kind,
  }

  /// What a task is for: the group Run Task lists it in.
  enum task-group {
    test,
    build,
    other,
  }

  /// A task for Run Task. One with a command line runs in a terminal tab
  /// of its own; one without runs in the plugin, as `run-command` with
  /// `task:<name>`.
  record task {
    name: string,
    command: option<string>,
    group: task-group,
    /// Shown dimmed beside it, such as `bin`.
    detail: string,
  }

  /// A test in a file, for the Tests view and ▶ Run Test over its line,
  /// from 0. One with a command line runs in the editor's test terminal,
  /// which reads cargo's results; one without runs in the plugin, as
  /// `run-command` with `run-test:<id>` or `debug-test:<id>`, and the
  /// plugin sends its results.
  record test-item {
    id: string,
    label: string,
    line: u32,
    command: option<string>,
  }

  enum test-outcome {
    passed,
    failed,
    skipped,
    running,
  }

  record test-result {
    id: string,
    outcome: test-outcome,
    /// Why it failed, on one line.
    message: string,
    /// The line in its file it failed on, from 0.
    line: option<u32>,
  }

  /// Something to debug, for Run and Debug and F5. The debugger is a
  /// manifest's `[[debuggers]]` id, or empty for the one for `language`.
  record debug-target {
    name: string,
    debugger: string,
    language: string,
    /// The program to start, relative to the workspace root or absolute.
    program: string,
    args: list<string>,
    /// A task's name or a command line, run first.
    build: string,
    /// Shown dimmed beside it, such as `--bin merlin`.
    detail: string,
    /// More of the debugger's own launch settings, as a JSON object.
    launch: string,
  }

  /// What F5 asked a debugger plugin to start, read with `debug-start`.
  record debug-launch {
    name: string,
    /// The debugger's id, and the command that starts it.
    debugger: string,
    command: list<string>,
    program: string,
    args: list<string>,
    cwd: string,
    env: list<tuple<string, string>>,
    /// The launch settings, as a JSON object: the manifest's `launch`, the
    /// target's and launch.toml's, merged. Keys the editor doesn't know
    /// pass through, for the debugger.
    launch: string,
    /// The ids of the stop filters the user turned on.
    stop-on: list<string>,
    /// What else the manifest says this debugger can stop on, as functions
    /// to break in: Rust's panics in `rust_panic`. Each is on or
    /// off as the user has it.
    function-stops: list<function-stop>,
  }

  /// A stop filter a manifest adds: a function breakpoint, offered with
  /// the debugger's own filters. A stop there is shown as an exception.
  record function-stop {
    id: string,
    label: string,
    /// Each name it may have, as versions differ: the ones not found are
    /// left out.
    functions: list<string>,
    on: bool,
  }

  /// A breakpoint the user set. The line is from 0. An empty condition,
  /// hit condition or log message is none.
  record breakpoint {
    id: u32,
    path: string,
    line: u32,
    condition: string,
    hit-condition: string,
    log-message: string,
    enabled: bool,
  }

  /// Why a program stopped.
  record debug-pause {
    /// As DAP has it: `breakpoint`, `step`, `exception`, `pause`, `entry`.
    reason: string,
    /// What went wrong, for an exception or a panic.
    description: string,
    thread: u32,
  }

  variant debug-state {
    starting,
    running,
    paused(debug-pause),
    /// How it ended: its exit code, if it had one.
    ended(option<s32>),
  }

  record debug-thread {
    id: u32,
    name: string,
    paused: bool,
  }

  /// A frame of a thread's stack. The path is empty when there's no source.
  record stack-frame {
    id: u32,
    name: string,
    path: string,
    /// From 0.
    line: u32,
    column: u32,
    /// In a library, not the project: folded in Call Stack.
    library: bool,
  }

  /// A variable, or a scope such as Locals. `children` is the reference
  /// that lists what's in it, or 0 for nothing.
  record debug-variable {
    name: string,
    value: string,
    type-name: string,
    children: u32,
  }

  /// Whether the debugger could set a breakpoint, where (from 0, or the
  /// largest u32 when it doesn't say), and if not, why.
  record breakpoint-state {
    id: u32,
    set: bool,
    line: u32,
    message: string,
  }

  /// What the debugger can stop on besides breakpoints, such as panics.
  record stop-filter {
    id: string,
    label: string,
    on: bool,
  }

  /// A value written after a line while paused, from 0.
  record inline-value {
    line: u32,
    text: string,
  }

  enum output-kind {
    console,
    stdout,
    stderr,
    important,
  }

  /// Something that happened to the open files.
  variant buffer-event {
    /// Another file became the active one.
    switched,
    /// The active file's text changed.
    changed,
    /// A file was saved. Its path.
    saved(string),
  }
}

/// What the editor offers a plugin. Calls that need a permission check the
/// plugin's manifest and return an error naming the permission if denied.
interface host {
  use types.{framing, pick-item, position, selection, text-change, diagnostic, detailed-diagnostic, code-action, file-edit, rename-info, location, project-symbol, completion, setting, token, token-layer, doc-symbol, line-range, fold-range, inlay-hint, signature, task, test-item, test-result, debug-target, debug-launch, function-stop, breakpoint, debug-state, debug-thread, stack-frame, debug-variable, breakpoint-state, stop-filter, inline-value, output-kind};

  /// Text of the active buffer. Needs `editor-read`.
  active-text: func() -> result<string, string>;

  /// The active buffer's version, which every change moves on. Needs
  /// `editor-read`.
  active-version: func() -> result<u64, string>;

  /// The changes to the active buffer since `since`, a version from
  /// `active-version`, oldest first: `none` once they're no longer kept,
  /// so read the whole text instead. Needs `editor-read`.
  active-changes: func(since: u64) -> result<option<list<text-change>>, string>;

  /// Path of the active buffer, if it has one. Needs `editor-read`.
  active-path: func() -> result<option<string>, string>;

  /// The cursor in the active buffer. Needs `editor-read`.
  active-cursor: func() -> result<position, string>;

  /// The selection in the active buffer, if anything is selected. Needs
  /// `editor-read`.
  active-selection: func() -> result<option<selection>, string>;

  /// The active buffer's lines changed since git's copy of it, each as
  /// its first and last line, or none when it isn't in git. Needs
  /// `editor-read`.
  changed-lines: func() -> result<option<list<line-range>>, string>;

  /// Inserts text at the cursor as one undo step. Needs `editor-write`.
  insert-text: func(text: string) -> result<_, string>;

  /// The folder the editor is working in.
  workspace-root: func() -> string;

  /// Shows a message in the status bar.
  notify: func(message: string);

  /// Shows this plugin's panel and focuses its first input.
  focus-panel: func();

  /// Replaces this plugin's diagnostics for a file. The path is relative to
  /// the workspace root, or absolute. They're underlined, and move with
  /// edits until the plugin sends new ones.
  set-diagnostics: func(path: string, diagnostics: list<diagnostic>);

  /// As `set-diagnostics`, with each one's source and code, which the
  /// hover card shows.
  set-detailed-diagnostics: func(path: string, diagnostics: list<detailed-diagnostic>);

  /// Colours a file: replaces this layer's tokens on `lines`, or in the
  /// whole file. Positions count UTF-16 columns, as LSP does. Tokens move
  /// with edits until the plugin sends new ones.
  set-tokens: func(path: string, layer: token-layer, lines: option<line-range>, tokens: list<token>);

  /// Replaces a file's symbols. Without any, the editor finds its own.
  set-symbols: func(path: string, symbols: list<doc-symbol>);

  /// Replaces where a file's blocks fold. Without any, they fold by
  /// indentation.
  set-folds: func(path: string, ranges: list<fold-range>);

  /// Replaces a file's inlay hints. They move with edits until the plugin
  /// sends new ones, and show unless the user turned them off.
  set-inlay-hints: func(path: string, hints: list<inlay-hint>);

  /// Shows a call's signature over the line being typed, until the cursor
  /// leaves the line, Escape, or this is called with none.
  show-signature: func(signature: option<signature>);

  /// Answers the editor's `code-actions` command with the actions at the
  /// cursor, for the editor to list (Ctrl+.) or offer in the hover card.
  show-code-actions: func(actions: list<code-action>);

  /// Changes files, each file's changes as one undo step. A file that
  /// isn't open is opened, changed and left unsaved. Needs
  /// `editor-write`.
  apply-edits: func(edits: list<file-edit>) -> result<_, string>;

  /// Answers the editor's `rename` command (F2): what the name at the
  /// cursor is and how far it reaches, or why it can't be renamed. The
  /// editor shows a box over the name; Enter calls `on-submit` with input
  /// `rename` and the new name, Shift+Enter with `rename-review`.
  show-rename: func(info: result<rename-info, string>);

  /// Answers `rename-review` with the rename's edits, for the user to
  /// look through and leave places out of before the editor makes them.
  show-rename-review: func(edits: list<file-edit>);

  /// Answers the editor's `references` command (Shift+F12): where the name
  /// at the cursor is used, for the editor's peek view.
  show-references: func(places: list<location>);

  /// What the palette's symbol search looks for, while the command a
  /// manifest's `symbols` names runs.
  symbol-query: func() -> string;

  /// Answers the palette's symbol search for `query`: the project's
  /// symbols whose names match it, best first.
  show-project-symbols: func(query: string, symbols: list<project-symbol>);

  /// Shows text next to the cursor until the next key.
  show-hover: func(text: string);

  /// Offers completions for the word at the cursor. The editor filters them
  /// as the user keeps typing.
  show-completions: func(items: list<completion>);

  /// Opens a file at a position, as go-to-definition does. Alt+Left goes
  /// back.
  open-at: func(path: string, at: position);

  /// Shows a proposed change to a file, from `old` to `new`, as a diff in
  /// its own tab. The user accepts or rejects it there, and the answer
  /// arrives at `on-review` with `id`. Showing an id again replaces it.
  show-diff: func(id: string, path: string, old: string, new: string);

  /// Closes a diff that was answered some other way.
  close-diff: func(id: string);

  /// Replaces this plugin's tasks in Run Task.
  set-tasks: func(tasks: list<task>);

  /// Replaces this plugin's tests in a file, which the Tests view lists
  /// and the file shows ▶ Run Test over. In a Rust file they take the
  /// place of the editor's own search for `#[test]`.
  set-tests: func(path: string, tests: list<test-item>);

  /// How this plugin's tests went, by id.
  set-test-results: func(results: list<test-result>);

  /// Runs a task by name, as Run Task does: the editor's own, or any
  /// plugin's.
  run-task: func(name: string);

  /// Replaces this plugin's things to debug in Run and Debug.
  set-debug-targets: func(targets: list<debug-target>);

  /// What to start, after the editor runs `debug.start` in this plugin: a
  /// debugger it drives, from a manifest's `[[debuggers]]`. The rest of a
  /// run's commands come the same way: `debug.continue`, `debug.pause`,
  /// `debug.step-over`, `debug.step-into`, `debug.step-out`,
  /// `debug.restart`, `debug.stop`, `debug.breakpoints` when they change,
  /// `debug.frame:<id>`, `debug.expand:<children>` and
  /// `debug.stop-on:<id>`. The Debug Console's input arrives at
  /// `on-submit` as `debug-console`. Needs `debugger`.
  debug-start: func() -> result<option<debug-launch>, string>;

  /// Every breakpoint the user set. Needs `debugger`.
  breakpoints: func() -> result<list<breakpoint>, string>;

  /// How the run is going: the toolbar, status bar and views follow it.
  /// Needs `debugger`, as do the calls after it.
  set-debug-state: func(state: debug-state) -> result<_, string>;
  set-threads: func(threads: list<debug-thread>) -> result<_, string>;
  set-stack: func(thread: u32, frames: list<stack-frame>) -> result<_, string>;
  /// What's in a variable or scope, by its `children`; 0 is the scopes of
  /// the frame shown.
  set-variables: func(parent: u32, variables: list<debug-variable>) -> result<_, string>;
  set-breakpoint-states: func(states: list<breakpoint-state>) -> result<_, string>;
  set-stop-filters: func(filters: list<stop-filter>) -> result<_, string>;
  /// Values to write after a file's lines while paused, in place of the
  /// editor's own from the frame's variables.
  set-inline-values: func(path: string, values: list<inline-value>) -> result<_, string>;
  /// Text for the Debug Console.
  debug-output: func(kind: output-kind, text: string) -> result<_, string>;
  /// A watch expression's value, by its place in Watch. The editor asks
  /// with `on-submit` input `debug-watch:<index>`, the expression as the
  /// text, while paused; `debug-set:<children>:<name>` sets a variable in
  /// what `children` lists to the text.
  set-watch: func(index: u32, value: debug-variable) -> result<_, string>;

  /// Lets the user pick one item. The choice arrives at `on-pick`.
  show-picker: func(id: string, title: string, items: list<pick-item>);

  /// Starts a program in the workspace root, with `env` added to the
  /// editor's environment. It must be listed in the manifest's `processes`
  /// permission, or, with `debugger`, be a debugger a plugin's manifest
  /// declares. It runs with the user's rights. Its output arrives at
  /// `on-process`.
  spawn: func(program: string, args: list<string>, env: list<tuple<string, string>>, framing: framing) -> result<u32, string>;

  /// Sends one message to a process, framed as it was spawned.
  send: func(process: u32, message: string) -> result<_, string>;

  kill: func(process: u32);

  /// One of this plugin's settings, by key: `[plugins.<name>]` in the
  /// user's or the workspace's settings.toml, or else the default in the
  /// manifest's `[settings]`. Dotted keys reach into tables. Read them when
  /// needed: they change while the plugin runs.
  get-setting: func(key: string) -> option<setting>;

  /// A secret this plugin stored, such as an API key. Each plugin sees only
  /// its own. They live in the system keyring when there is one.
  get-secret: func(key: string) -> option<string>;
  set-secret: func(key: string, value: string) -> result<_, string>;
  delete-secret: func(key: string);
}

world plugin {
  import host;
  use types.{command, panel, process-event, buffer-event, token};

  /// Called after loading, and again after every hot reload with what
  /// `save-state` returned.
  export activate: func(state: option<list<u8>>) -> list<command>;
  /// Called before a hot reload. A plugin that returns state also keeps its
  /// processes running across the reload; one that returns none has them
  /// stopped.
  export save-state: func() -> option<list<u8>>;
  export run-command: func(id: string);
  /// Called when the panel is visible and something may have changed.
  export render-panel: func() -> option<panel>;
  export on-click: func(button: string);
  export on-submit: func(input: string, text: string);
  export on-pick: func(picker: string, item: string);
  export on-process: func(process: u32, event: process-event);
  export on-buffer: func(event: buffer-event);
  /// The user's answer to a diff shown with `show-diff`.
  export on-review: func(id: string, accepted: bool);
  /// Colours some text in one of the languages the plugin adds, named by
  /// its id or an extension: a diff of a file, or a code block in Markdown.
  /// Positions are within the text.
  export colour-text: func(language: string, text: string) -> list<token>;
}
